revision 1;

// A multi-tenant platform's caches: tenancy (operator, brand, site), settings
// and finance. Tags are the C# [Key(N)] plus one. Members C# marks
// [IgnoreMember] and fills from a header have no tag. C#'s ushort and uint are
// int32 and int64 here: MessagePack writes an integer the same way whatever its
// C# width.
namespace Tenant;

// --- tenancy: platform.operator / brand / site / settings.cache.v1 ----------

table OperatorInfo
  [cs: DataCacheTopic("platform.operator.cache.v1")]
{
  key uuid id = 1;
  int32 schema_version [header("schema-version")];

  string         slug               = 2;
  string         name               = 3;
  string?        legal_entity       = 4;
  OperatorStatus status             = 5;
  Currency       base_currency      = 6;
  string         base_currency_code = 7;
  int64          created_at_unix_ms = 8;
  int64          updated_at_unix_ms = 9;
}

table BrandInfo
  [cs: DataCacheTopic("platform.brand.cache.v1")]
{
  key uuid id = 1;
  int32 schema_version [header("schema-version")];

  uuid        operator_id        = 2 [references(OperatorInfo)];
  string      slug               = 3;
  string      name               = 4;
  BrandStatus status             = 5;
  int64       created_at_unix_ms = 6;
  int64       updated_at_unix_ms = 7;
}

table SiteInfo
  [cs: DataCacheTopic("platform.site.cache.v1")]
{
  key uuid id = 1;
  int32 schema_version [header("schema-version")];

  uuid   brand_id           = 2 [references(BrandInfo)];
  uuid   operator_id        = 3 [references(OperatorInfo)];
  string domain             = 4;
  string slug               = 5;
  int64  created_at_unix_ms = 6;
  int64  updated_at_unix_ms = 7;
  uuid   license_id         = 8;
}

struct PlatformSettingKey {
  PlatformSettingType type      = 1;
  uuid?               tenant_id = 2;
}

record PasswordLimitRule {
  PasswordRuleMode mode   = 1;
  int32?           value  = 2;
  bool?            locked = 3;
}

record PasswordPolicySetting {
  int32             min_length                    = 1;
  bool              require_uppercase             = 2;
  bool              require_lowercase             = 3;
  bool              require_number                = 4;
  bool              require_symbol                = 5;
  PasswordLimitRule expiry                        = 6;
  PasswordLimitRule lockout                       = 7;
  bool              passkeys_allowed_for_everyone = 8;
}

table PlatformSetting
  [cs: DataCacheTopic("platform.settings.cache.v1")]
{
  // Tag 5 was a second password policy, since retired: never reuse it.
  reserved 5;

  key PlatformSettingKey key = 1;
  int32 schema_version [header("schema-version")];
  int32 setting_type   [header("setting-type")];
  uuid  tenant_id      [header("tenant-id")];

  int32                  version            = 2;
  int64                  updated_at_unix_ms = 3;
  PasswordPolicySetting? password_policy    = 4;
}

// --- settings: platform.setting-values.cache.v1 -----------------------------

struct SettingKey {
  uuid        owner      = 1;
  SettingGroup group     = 2;
  SettingCode code       = 3;
  uuid?       subject_id = 4;
}

// SettingValue's own MessagePack formatter writes [kind, payload]. A Guid
// payload is 16 bytes in Guid.TryWriteBytes's layout rather than the string
// MessagePack-CSharp writes for a Guid member, so it is `bytes` here; an
// Object payload is a MessagePack map passed through as written.
union SettingValue of SettingKind {
  NIL;
  BOOL   bool;
  INT    int64;
  REAL   double;
  GUID   bytes;
  STRING string;
  BYTES  bytes;
  JSON   string;
  OBJECT raw;
}

table Setting
  [cs: DataCacheTopic("platform.setting-values.cache.v1")]
{
  key SettingKey key = 1;

  SettingValue      value              = 2;
  SettingLock       lock_state         = 3;
  int32             version            = 4;
  int64             created_at_unix_ms = 5;
  int64             updated_at_unix_ms = 6;
  SettingEntityType entity_type        = 7;
  SettingOwnerType  owner_type         = 8;

  int32 schema_version     [header("schema-version")];
  int32 setting_group      [header("setting-group")];
  int32 setting_code       [header("setting-code")];
  int32 entity_type_number [header("entity-type")];
  uuid? operator_id        [header("operator-id")];
  uuid? brand_id           [header("brand-id")];
  uuid? site_id            [header("site-id")];
}

// --- finance: platform.currency / exchange-rate / rate-provider ------------

table CurrencyInfo
  [cs: DataCacheTopic("finance.currency.cache.v1")]
{
  key int32 number = 1; // ushort

  string code             = 2;
  string name             = 3;
  string kind             = 4;
  int32  minor_unit       = 5;
  int32  storage_exponent = 6;
  bool   is_enabled       = 7;
  bool   is_pivot         = 8;
  string provider         = 9;
}

table ExchangeRate
  [cs: DataCacheTopic("finance.exchange-rate.cache.v1")]
{
  key int64 pair = 1; // uint

  int32  base                   = 2 [references(CurrencyInfo)]; // ushort
  int32  quote                  = 3 [references(CurrencyInfo)]; // ushort
  string base_code              = 4;
  string quote_code             = 5;
  int64  rate_mantissa          = 6;
  int32  rate_scale             = 7;
  string source                 = 8;
  string provider               = 9;
  int64  effective_from_unix_ms = 10;
  int64  snapshot_id            = 11;
  int64  rate_id                = 12;
}

table RateProviderStatus
  [cs: DataCacheTopic("finance.rate-provider.cache.v1")]
{
  key string provider = 1;

  int64 snapshot_id              = 2;
  int64 vendor_timestamp_unix_ms = 3;
  int64 next_update_unix_ms      = 4;
  int64 last_checked_unix_ms     = 5;
}

// --- enums -------------------------------------------------------------------

